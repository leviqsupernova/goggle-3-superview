<ui:FluentWindow x:Class="Goggles3.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Goggle 3 LiveView" Width="1180" Height="760" MinWidth="860" MinHeight="540" Background="Black" Foreground="White"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterScreen" Icon="AppIcon.png"
 PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Title and status above the video, never on it. -->
  <ui:TitleBar x:Name="TitleBar" Title="Goggle 3 LiveView" Background="{StaticResource Chrome}">
   <ui:TitleBar.Icon><ui:ImageIcon Source="pack://application:,,,/AppIcon.png"/></ui:TitleBar.Icon>
   <ui:TitleBar.TrailingContent>
    <Border Background="#14FFFFFF" CornerRadius="11" Padding="10,3,12,4" Margin="0,0,12,0" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="StatusDot" Fill="{StaticResource Off}" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="Status" Text="Not connected" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.AutomationId="ConnectionStatus"/>
     </StackPanel>
    </Border>
   </ui:TitleBar.TrailingContent>
  </ui:TitleBar>

  <Grid x:Name="Stage" Grid.Row="1" Background="Black">
   <Grid x:Name="Idle">
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1F24" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Grid.Background>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
     <Viewbox Width="68" Height="52" Margin="0,0,0,20"><Path Stroke="#D966D4CA" StrokeThickness="1.5" Data="M 4,9 Q 3,3 10,3 L 38,3 Q 45,3 44,9 L 42,20 Q 41,24 35,24 L 27,22 Q 24,17 21,22 L 13,24 Q 6,24 5,20 Z M 1,11 L 1,18 M 47,11 L 47,18"/></Viewbox>
     <TextBlock x:Name="IdleTitle" Text="Plug in the goggles, then click Connect" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="IdleTitle"/>
     <TextBlock x:Name="IdleHint" Text="Use a USB-C data cable. Tutorial shows the goggles settings." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
   <Image x:Name="Video" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="LowQuality"/>
  </Grid>

  <!-- Controls below the video: the goggles OSD sits at the bottom edge of the picture. -->
  <Border x:Name="ControlBar" Grid.Row="2" Background="{StaticResource Chrome}" BorderBrush="{StaticResource ChromeLine}" BorderThickness="0,1,0,0" Padding="16,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <ui:Button x:Name="ConnectButton" Appearance="Primary" Content="Connect" MinWidth="136" Click="ConnectClick" AutomationProperties.AutomationId="ConnectButton">
      <ui:Button.Icon><ui:SymbolIcon Symbol="PlugConnected24"/></ui:Button.Icon>
     </ui:Button>
     <ui:Button x:Name="RecordButton" Content="Record" MinWidth="112" Margin="8,0,0,0" IsEnabled="False" Click="RecordClick" AutomationProperties.AutomationId="RecordButton">
      <ui:Button.Icon><ui:SymbolIcon Symbol="Record24"/></ui:Button.Icon>
     </ui:Button>
     <ui:Button x:Name="FullscreenButton" Margin="8,0,0,0" ToolTip="Fullscreen (F11). Press Esc to exit." Click="FullscreenClick"
      AutomationProperties.Name="Fullscreen" AutomationProperties.AutomationId="FullscreenButton">
      <ui:Button.Icon><ui:SymbolIcon Symbol="FullScreenMaximize24"/></ui:Button.Icon>
     </ui:Button>
     <ui:Button x:Name="TutorialButton" Content="Tutorial" Margin="8,0,0,0" Click="TutorialClick" AutomationProperties.AutomationId="TutorialButton">
      <ui:Button.Icon><ui:SymbolIcon Symbol="QuestionCircle24"/></ui:Button.Icon>
     </ui:Button>
    </StackPanel>
    <TextBlock x:Name="RecordingText" Grid.Column="1" Margin="20,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}"
     TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="RecordingText"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="14" Typography.NumeralAlignment="Tabular">
     <TextBlock x:Name="Fps" Visibility="Collapsed" MinWidth="56" TextAlignment="Right" ToolTip="Frames shown per second"/>
     <TextBlock x:Name="Bitrate" Visibility="Collapsed" MinWidth="88" TextAlignment="Right" Margin="12,0,0,0" ToolTip="Video data from the goggles"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</ui:FluentWindow>
