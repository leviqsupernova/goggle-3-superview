<Application x:Class="Goggles3.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ui:ThemesDictionary Theme="Dark"/>
    <ui:ControlsDictionary/>
   </ResourceDictionary.MergedDictionaries>
   <!-- Dark chrome around the video: title bar, control bar, tutorial. -->
   <SolidColorBrush x:Key="Chrome" Color="#0F1517"/>
   <SolidColorBrush x:Key="ChromeLine" Color="#1FFFFFFF"/>
   <SolidColorBrush x:Key="Muted" Color="#A6FFFFFF"/>
   <SolidColorBrush x:Key="Mint" Color="#30DBCF"/>
   <SolidColorBrush x:Key="Amber" Color="#F2C14E"/>
   <SolidColorBrush x:Key="Alert" Color="#FF7A6B"/>
   <SolidColorBrush x:Key="Off" Color="#66FFFFFF"/>
  </ResourceDictionary>
 </Application.Resources>
</Application>
